    {"id": "clearbit", "type": "INTEGRATION", "label": "Clearbit Enrichment", "description": "Writes industry."},

    {"id": "CHANGE-1007", "type": "CHANGE", "label": "Enterprise branch removed", "description": "Enterprise branch removed from derive_pricing_segment."}
