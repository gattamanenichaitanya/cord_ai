    {"id": "data_warehouse_sync", "type": "INTEGRATION", "label": "Data Warehouse Sync", "description": "Analytics warehouse sync."},
    {"id": "billing_stripe", "type": "INTEGRATION", "label": "Billing (Stripe)", "description": "Syncs MRR."},
